# Dev/local should use a separate db, e.g. karaoq_dev — see docs/engineering/environments.md.
MONGODB_URI=
MONGODB_DB=
NEXT_PUBLIC_YOUTUBE_API_KEY=
ANALYTICS_SECRET=
# "1" silences lib/dbGuard.ts's warning when deliberately using MONGODB_DB=karaoq.
KARAOQ_ALLOW_PROD_DB=
# ntfy.sh topic for ops pages (currently: YouTube quota exhausted). Topics are
# public-by-name — anyone who knows the string can read it — so treat this as a
# secret and pick something unguessable. Leave blank outside production: with no
# value, the alerting path is inert.
NTFY_TOPIC=
